{
  "expo": {
    "name": "Lingua",
    "slug": "hsk-learning-ios",
    "icon": "./assets/images/app-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#fff7f2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.uva3840.teal2153",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cho phép ứng dụng dùng micro để luyện nói tiếng Trung.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "vandinh.hsklearning",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-audio",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "3690d26e-abee-4de8-9dcb-88e39095bca9"
      }
    }
  }
}
